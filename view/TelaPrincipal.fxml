<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="391.0" prefWidth="700.0" styleClass="painel" stylesheets="@../util/principal.css" xmlns="http://javafx.com/javafx/8.0.431" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TelaPrincipalController">
   <children>
      <AnchorPane style="-fx-background-color: rgba(0, 0, 0, 0.73);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
      <HBox spacing="30.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button id="redondo" fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltar" prefHeight="32.0" prefWidth="34.0" styleClass="botao" stylesheets="@../util/principal.css" text="&lt;-" />
                        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                           <children>
                              <Label id="grande" stylesheets="@../util/principal.css" text="Resultados" />
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <TabPane styleClass="painelTab" stylesheets="@../util/principal.css" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                     <tabs>
                        <Tab text="Léxico">
                           <content>
                              <AnchorPane>
                                 <children>
                                    <TextArea fx:id="txtLexico" editable="false" styleClass="caixaTexto" stylesheets="@../util/principal.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                                 </children>
                              </AnchorPane>
                           </content>
                        </Tab>
                        <Tab text="Sintático">
                           <content>
                              <AnchorPane>
                                 <children>
                                    <TextArea fx:id="txtSintatico" editable="false" styleClass="caixaTexto" stylesheets="@../util/principal.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                                 </children>
                              </AnchorPane>
                           </content>
                        </Tab>
                     </tabs>
                  </TabPane>
               </children>
            </VBox>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="5.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label id="grande" stylesheets="@../util/principal.css" text="Código" />
                        <TextArea fx:id="txtCodigo" editable="false" styleClass="caixaTexto" stylesheets="@../util/principal.css" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="5.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Label id="grande" stylesheets="@../util/principal.css" text="Erros" />
                        <TextArea id="erros" fx:id="txtErros" editable="false" styleClass="caixaTexto" stylesheets="@../util/principal.css" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button id="abrir" fx:id="btnAbrirArquivo" disable="true" mnemonicParsing="false" onAction="#abrirArquivo" prefHeight="39.0" prefWidth="133.0" styleClass="botao" stylesheets="@../util/principal.css" text="Abrir Arquivo" />
                        <Button id="excluir" fx:id="btnExcluirArquivo" disable="true" mnemonicParsing="false" onAction="#excluirArquivo" prefHeight="39.0" prefWidth="133.0" styleClass="botao" stylesheets="@../util/principal.css" text="Excluir Arquivo" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>